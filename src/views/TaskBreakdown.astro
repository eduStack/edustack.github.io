---
import Base from '../layouts/Base.astro';
import yaml from 'js-yaml';
import templatesRaw from '../data/task-breakdown.yaml?raw';
import { getTool, type Lang } from '../lib/data';
import ToolContext from '../components/ToolContext.astro';
import { href } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
const tool = getTool('task-breakdown');
const templates = yaml.load(templatesRaw) as { id: string; title: { en: string; zh: string }; summary: { en: string; zh: string }; steps: { en: string[]; zh: string[] } }[];
const copy = zh ? {
  template: '选择一个开始方式', blank: '从空白开始', task: '任务名称', step: '步骤', add: '添加一步', save: '保存到本机', restore: '恢复已保存内容', clear: '清除本机保存', fresh: '开始新任务', print: '打印', saved: '已保存到这台浏览器。', unsaved: '有未保存的修改。', empty: '还没有保存的任务。', saveError: '保存失败，当前内容仍可继续编辑或打印。', clearConfirm: '清除本机保存的任务？当前编辑内容也会清空。', newConfirm: '当前有未保存修改，确定开始新任务吗？', overwriteConfirm: '另一个标签页更新了保存内容。仍要用当前内容覆盖吗？', externalChange: '另一个标签页更新了保存内容；请先恢复或确认覆盖。', leaveConfirm: '当前有未保存修改，确定离开吗？', remove: '删除', up: '上移', down: '下移', required: '至少保留一步。', privacy: '这是一份本地草稿。不会写入孩子档案、网址或公开页面。', back: '返回工具目录'
} : {
  template: 'Choose a starting point', blank: 'Start blank', task: 'Task name', step: 'Step', add: 'Add a step', save: 'Save on this device', restore: 'Restore saved task', clear: 'Clear device save', fresh: 'Start a new task', print: 'Print', saved: 'Saved in this browser.', unsaved: 'You have unsaved changes.', empty: 'There is no saved task yet.', saveError: 'Saving failed. You can keep editing or print the current task.', clearConfirm: 'Clear the saved task? The current draft will also be cleared.', newConfirm: 'You have unsaved changes. Start a new task?', overwriteConfirm: 'Another tab updated the saved task. Overwrite it with this draft?', externalChange: 'Another tab updated the saved task; restore it or confirm an overwrite.', leaveConfirm: 'You have unsaved changes. Leave this page?', remove: 'Delete', up: 'Move up', down: 'Move down', required: 'Keep at least one step.', privacy: 'This is a local draft. It is not written to a child profile, URL or public page.', back: 'Back to tools'
};
const labels = { ...copy, title: tool.name[lang], intro: tool.what[lang], restoreConfirm: zh ? '恢复已保存内容会替换当前未保存的修改，确定继续吗？' : 'Restoring the saved task will replace your unsaved changes. Continue?' };
const templateData = JSON.stringify(templates);
---
<Base lang={lang} title={labels.title} description={labels.intro} active="tools">
  <main id="main" tabindex="-1" class="wrap task-tool">
    <nav class="row muted" aria-label={zh ? '位置' : 'Breadcrumb'}><a href={href(lang, 'tools')}>{labels.back}</a><span aria-hidden="true">/</span><span>{labels.title}</span></nav>
    <header class="stack intro">
      <div class="chips"><span class="chip t-tool">{zh ? '本站工具' : 'eduStack tool'}</span><span class="chip">{zh ? '6–11 岁起点' : 'Starting ages 6–11'}</span></div>
      <h1 class="h-serif">{labels.title}</h1>
      <p class="prose">{labels.intro}</p>
      <p class="muted privacy-note">{labels.privacy}</p>
    </header>
    <p class="callout" data-tool-unavailable>{zh ? '请开启 JavaScript 并重新加载页面以使用工具。下方的用途和依据仍可阅读。' : 'Enable JavaScript and reload this page to use the tool. Its purpose and sources remain readable below.'}</p>
    <fieldset class="task-panel" disabled data-tool-controls aria-labelledby="task-heading">
      <h2 id="task-heading" class="sr-only">{labels.title}</h2>
      <div class="task-toolbar">
        <label for="template">{labels.template}</label>
        <select id="template" data-template>
          <option value="blank">{labels.blank}</option>
          {templates.map((template) => <option value={template.id}>{template.title[lang]}</option>)}
        </select>
        <button class="btn" type="button" data-new>{labels.fresh}</button>
      </div>
      <label class="field-label" for="task-title">{labels.task}</label>
      <input id="task-title" class="task-title" data-title maxlength="80" autocomplete="off" />
      <span class="print-title" data-print-title></span>
      <div class="step-heading"><h3>{labels.step}</h3><span class="muted" data-count></span></div>
      <ol class="steps" data-steps aria-label={labels.step}></ol>
      <button class="btn add-step" type="button" data-add>{labels.add}</button>
      <div class="task-actions">
        <button class="btn btn-primary" type="button" data-save>{labels.save}</button>
        <button class="btn" type="button" data-restore>{labels.restore}</button>
        <button class="btn" type="button" data-print>{labels.print}</button>
        <button class="btn danger" type="button" data-clear>{labels.clear}</button>
      </div>
      <p class="status" role="status" aria-live="polite" data-status></p>
    </fieldset>
    <ToolContext tool={tool} lang={lang} />
    {tool.limits && <p class="print-only">{tool.limits[lang]}</p>}
  </main>
</Base>
<script define:vars={{ templateData, labels, storageKey: 'edustack.task-breakdown.v1' }}>
  const templates = JSON.parse(templateData);
  const templateSelect = document.querySelector('[data-template]');
  const titleInput = document.querySelector('[data-title]');
  const printTitle = document.querySelector('[data-print-title]');
  const stepsList = document.querySelector('[data-steps]');
  const count = document.querySelector('[data-count]');
  const status = document.querySelector('[data-status]');
  const newId = () => globalThis.crypto?.randomUUID?.() ?? `step-${Date.now()}-${Math.random().toString(16).slice(2)}`;
  const blank = () => ({ version: 1, title: '', steps: [{ id: newId(), text: '', done: false }] });
  let draft = blank();
  let dirty = false;
  let externalChange = false;
  let activeTemplate = 'blank';
  const say = (message) => { status.textContent = message; };
  const markDirty = () => { dirty = true; window.dispatchEvent(new CustomEvent('edustack:dirty')); say(labels.unsaved); };
  const valid = (value) => value && value.version === 1 && typeof value.title === 'string' && value.title.length <= 80 && Array.isArray(value.steps) && value.steps.length >= 1 && value.steps.length <= 30 && new Set(value.steps.map((step) => step?.id)).size === value.steps.length && value.steps.every((step) => step && typeof step.id === 'string' && step.id.length <= 100 && typeof step.text === 'string' && step.text.length <= 160 && typeof step.done === 'boolean');
  const readSaved = () => { try { const value = JSON.parse(localStorage.getItem(storageKey) || 'null'); return valid(value) ? value : null; } catch { return null; } };
  const writeSaved = () => { if (externalChange && !window.confirm(labels.overwriteConfirm)) return; try { localStorage.setItem(storageKey, JSON.stringify(draft)); dirty = false; externalChange = false; window.dispatchEvent(new CustomEvent('edustack:clean')); say(labels.saved); } catch { say(labels.saveError); } };
  const render = (focus = null) => {
    titleInput.value = draft.title;
    printTitle.textContent = draft.title || labels.task;
    stepsList.replaceChildren();
    draft.steps.forEach((step, index) => {
      const item = document.createElement('li'); item.className = 'step-row'; item.dataset.stepId = step.id;
      const number = document.createElement('span'); number.className = 'step-number'; number.textContent = String(index + 1); number.setAttribute('aria-hidden', 'true');
      const check = document.createElement('input'); check.type = 'checkbox'; check.checked = step.done; check.ariaLabel = `${labels.step} ${index + 1}`;
      check.addEventListener('change', () => { step.done = check.checked; markDirty(); });
      const input = document.createElement('input'); input.type = 'text'; input.maxLength = 160; input.value = step.text; input.placeholder = `${labels.step} ${index + 1}`; input.setAttribute('aria-label', `${labels.step} ${index + 1}`);
      const printText = document.createElement('span'); printText.className = 'print-step'; printText.textContent = step.text || ' ';
      input.addEventListener('input', () => { step.text = input.value; printText.textContent = step.text || ' '; markDirty(); });
      const controls = document.createElement('span'); controls.className = 'step-controls';
      const button = (text, label, key, action, disabled = false) => { const button = document.createElement('button'); button.type = 'button'; button.className = 'icon-btn'; button.dataset.stepAction = key; button.textContent = text; button.setAttribute('aria-label', label); button.disabled = disabled; button.addEventListener('click', action); controls.append(button); };
      button('↑', `${labels.up} ${index + 1}`, 'up', () => { [draft.steps[index - 1], draft.steps[index]] = [draft.steps[index], draft.steps[index - 1]]; markDirty(); render({ id: step.id, action: 'up' }); }, index === 0);
      button('↓', `${labels.down} ${index + 1}`, 'down', () => { [draft.steps[index], draft.steps[index + 1]] = [draft.steps[index + 1], draft.steps[index]]; markDirty(); render({ id: step.id, action: 'down' }); }, index === draft.steps.length - 1);
      button('×', `${labels.remove} ${index + 1}`, 'remove', () => { if (draft.steps.length === 1) return say(labels.required); draft.steps.splice(index, 1); markDirty(); render({ id: draft.steps[Math.min(index, draft.steps.length - 1)].id, action: 'remove' }); });
      item.append(number, check, input, printText, controls); stepsList.append(item);
    });
    count.textContent = `${draft.steps.length}/30`;
    if (focus) {
      const row = [...stepsList.children].find((item) => item.dataset.stepId === focus.id);
      const action = row?.querySelector(`[data-step-action="${focus.action}"]:not(:disabled)`);
      (action || row?.querySelector('input[type="text"]'))?.focus();
    }
  };
  const choose = (id) => { const template = templates.find((item) => item.id === id); activeTemplate = id; draft = template ? { version: 1, title: template.title[document.body.dataset.lang === 'zh' ? 'zh' : 'en'], steps: template.steps[document.body.dataset.lang === 'zh' ? 'zh' : 'en'].map((text) => ({ id: newId(), text, done: false })) } : blank(); dirty = false; externalChange = false; window.dispatchEvent(new CustomEvent('edustack:clean')); say(''); render(); };
  titleInput.addEventListener('input', () => { draft.title = titleInput.value; printTitle.textContent = draft.title || labels.task; markDirty(); });
  templateSelect.addEventListener('change', () => { const next = templateSelect.value; if (dirty && !window.confirm(labels.newConfirm)) { templateSelect.value = activeTemplate; return; } choose(next); });
  document.querySelector('[data-add]').addEventListener('click', () => { if (draft.steps.length >= 30) return; const id = newId(); draft.steps.push({ id, text: '', done: false }); markDirty(); render({ id, action: 'input' }); });
  document.querySelector('[data-save]').addEventListener('click', writeSaved);
  document.querySelector('[data-restore]').addEventListener('click', () => { const value = readSaved(); if (!value) return say(labels.empty); if (dirty && !window.confirm(labels.restoreConfirm)) return; draft = value; activeTemplate = 'blank'; templateSelect.value = 'blank'; dirty = false; externalChange = false; window.dispatchEvent(new CustomEvent('edustack:clean')); say(labels.saved); render(); });
  document.querySelector('[data-clear]').addEventListener('click', () => { if (!window.confirm(labels.clearConfirm)) return; try { localStorage.removeItem(storageKey); draft = blank(); dirty = false; externalChange = false; window.dispatchEvent(new CustomEvent('edustack:clean')); say(''); render(); } catch { say(labels.saveError); } });
  document.querySelector('[data-new]').addEventListener('click', () => { if (dirty && !window.confirm(labels.newConfirm)) return; templateSelect.value = 'blank'; choose('blank'); });
  document.querySelector('[data-print]').addEventListener('click', () => window.print());
  const savedDraft = readSaved();
  if (savedDraft) { draft = savedDraft; window.dispatchEvent(new CustomEvent('edustack:clean')); say(labels.saved); }
  window.addEventListener('storage', (event) => { if (event.key !== storageKey && event.key !== null) return; if (!event.newValue) { externalChange = true; say(labels.externalChange); return; } try { if (valid(JSON.parse(event.newValue))) { externalChange = true; say(labels.externalChange); } } catch { /* Ignore malformed cross-tab data. */ } });
  window.addEventListener('beforeunload', (event) => { if (dirty) { event.preventDefault(); event.returnValue = ''; } });
  render();
  document.querySelector('[data-tool-controls]').disabled = false;
  document.querySelector('[data-tool-unavailable]').hidden = true;
</script>
<style>
  .task-tool { padding-block: 2rem 4rem; display: flex; flex-direction: column; gap: 2rem; }
  .intro { max-width: 52rem; }
  .privacy-note { border-inline-start: 3px solid var(--accent); padding-inline-start: 0.75rem; }
  .task-panel { margin: 0; min-inline-size: 0; display: flex; flex-direction: column; gap: 1rem; max-width: 54rem; padding: clamp(1rem, 3vw, 2rem); border: 1px solid var(--line); background: var(--paper); }
  .task-toolbar, .task-actions, .step-heading { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
  .task-toolbar label, .field-label, .step-heading h3 { font-weight: 650; }
  select, input { font: inherit; color: var(--ink); background: var(--paper); border: 1px solid var(--line-strong); padding: 0.65rem 0.75rem; border-radius: 0; }
  select { min-width: min(14rem, 100%); max-width: 100%; }
  .task-title { width: 100%; font-size: var(--type-section); }
  .print-title, .print-step { display: none; }
  .step-heading { justify-content: space-between; margin-top: 0.5rem; }
  .step-heading h3 { margin: 0; font-size: var(--type-body); }
  .steps { display: flex; flex-direction: column; gap: 0.6rem; margin: 0; padding-inline-start: 0; list-style: none; }
  :global(.step-row) { display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; gap: 0.5rem; align-items: center; }
  :global(.step-number) { min-inline-size: 1.7rem; text-align: center; color: var(--muted); }
  :global(.step-row input[type='text']) { width: 100%; }
  :global(.step-controls) { display: flex; flex-wrap: wrap; gap: 0.25rem; }
  :global(.icon-btn) { min-width: 2rem; min-height: 2rem; padding: 0.2rem; border: 1px solid var(--line); background: var(--shelf); color: var(--ink); cursor: pointer; }
  :global(.icon-btn:disabled) { opacity: 0.4; cursor: default; }
  .add-step { align-self: flex-start; }
  .task-actions { border-top: 1px solid var(--line); padding-top: 1rem; }
  .danger { color: var(--danger, #8d2929); }
  .status { min-height: 1.5em; margin: 0; color: var(--ink-2); }
  .basis { max-width: 54rem; }
  @media (max-width: 38rem) { :global(.step-row) { grid-template-columns: auto auto minmax(0, 1fr); } :global(.step-controls) { grid-column: 3; } select { width: 100%; } }
  @media print { .task-tool { padding: 0; } .task-toolbar, .task-actions, .add-step, .privacy-note, nav, .basis { display: none !important; } :global(.step-controls) { display: none !important; } .task-panel { border: 0; padding: 0; } .task-title { display: none; } .print-title { display: block; font-size: var(--type-section); font-weight: 650; overflow-wrap: anywhere; } :global(.step-row input[type='text']) { display: none; } :global(.step-row .print-step) { display: block; grid-column: 3 / -1; min-width: 0; white-space: pre-wrap; overflow-wrap: anywhere; } }
</style>

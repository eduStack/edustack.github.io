---
import '../styles/editorial.css';
import { editorialCopy } from '../i18n/editorial';
import { defaultLanguage, languages, type Lang } from '../i18n/languages';
import { href } from '../i18n/ui';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = editorialCopy[lang];
const localPath = (path: string) => href(lang, path);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sitePath = (path: string) => `${base}${path}`;
const homeUrl = href(lang);
const canonical = new URL(homeUrl, Astro.site || Astro.url.origin);
---
<!doctype html>
<html lang={languages[lang].tag}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#faf7f0">
  <link rel="canonical" href={canonical} />
  {(Object.keys(languages) as Lang[]).map((code) => <link rel="alternate" hreflang={languages[code].tag} href={new URL(href(code), Astro.site || Astro.url.origin)} />)}
  <link rel="alternate" hreflang="x-default" href={new URL(href(defaultLanguage), Astro.site || Astro.url.origin)} />
  <meta name="description" content={copy.description}>
  <title>{copy.pageTitle}</title>
  <link rel="icon" href={sitePath('/editorial/favicon.svg')} type="image/svg+xml">
  
</head>
<body>
  <a class="skip-link" href="#main">{copy.skip}</a>
  <div class="utility-bar">
    <div class="wrap utility-inner"><span>{copy.tagline} <span class="utility-dot">·</span> {copy.ageSpan}</span><LanguageSwitcher lang={lang} /></div>
  </div>
  <header class="site-header wrap">
    <div class="masthead">
      <p class="masthead-note">{copy.mastheadFirst}<br>{copy.mastheadSecond}</p>
      <a class="brand" href={homeUrl} aria-label={copy.homeLabel}><span class="brand-name">Edu<span>stack</span><svg viewBox="0 0 34 34" aria-hidden="true"><path d="M7 26C7 15 11 6 26 5c-1 13-7 21-19 21Z"/><path d="m7 28 13-15"/></svg></span><span class="brand-subtitle">THE ART & SCIENCE OF GROWING TOGETHER</span></a>
      <a class="profile-link" href={localPath('me/')}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2"/><path d="M5 20v-2a7 7 0 0 1 14 0v2"/></svg>{copy.myChild}<span aria-hidden="true">↗</span></a>
    </div>
    <nav class="main-nav" aria-label={copy.mainNav}>
      <a class="active" href={homeUrl} aria-current="page">{copy.home}</a>
      <a href="#ages">{copy.byAge}</a>
      <a href="#topics">{copy.parentQuestions}</a>
      <a href={localPath('tools/')}>{copy.play}</a>
      <a href="#reading">{copy.reading}</a>
      <a href={localPath('educators/')}>{copy.educators}</a>
      <a class="search-link" href="#resource-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.7"/><path d="m16 16 5 5"/></svg><span>{copy.search}</span></a>
    </nav>
  </header>

  <main id="main" tabindex="-1">
    <div class="wrap">
      <section class="opening" aria-labelledby="opening-title">
        <div class="opening-copy"><h1 id="opening-title">{copy.headline}</h1><p>{copy.intro}</p></div>
        <form id="search-panel" class="search-panel" role="search" aria-label={copy.searchLabel} action={localPath('library/')} method="get">
          <label for="resource-search">{copy.searchQuestion}</label>
          <div><input id="resource-search" type="search" name="q" placeholder={copy.searchPlaceholder} required><button type="submit">{copy.search}</button></div>
        </form>
      </section>

      <section class="lead-grid" aria-label={copy.featured}>
        <article class="lead-story">
          <a class="lead-image" href={localPath('ages/toddlers/')} aria-label={copy.leadLabel}><span class="image-note">{copy.imageNote}</span><svg class="family-art" viewBox="0 0 900 500" role="img" aria-label={copy.familyAlt}><use href={sitePath('/editorial/illustrations.svg#family')}/></svg></a>
          <div class="story-meta"><span class="eyebrow">{copy.leadEyebrow}</span><span>{copy.leadCategory}</span></div>
          <h2><a href={localPath('ages/toddlers/')}>{copy.leadTitleFirst}<br>{copy.leadTitleSecond}</a></h2>
          <p class="story-description">{copy.leadDescription}</p>
          <div class="story-bottom"><div class="source-details"><span>{copy.leadSources}</span><span>{copy.stageUpdated} <time datetime="2026-11-13">2026-11-13</time></span></div><a class="text-link" href={localPath('ages/')}>{copy.startAge} <span aria-hidden="true">↗</span></a></div>
        </article>

        <aside class="sidebar">
          <article class="today-note">
            <div class="note-top"><span class="eyebrow">{copy.today}</span><svg viewBox="0 0 35 35" aria-hidden="true"><circle cx="17.5" cy="17.5" r="7"/><path d="M17.5 2v4m0 23v4M2 17.5h4m23 0h4M6.5 6.5l3 3m16 16 3 3m0-22-3 3m-16 16-3 3"/></svg></div>
            <span class="note-age">{copy.todayAge}</span>
            <h2>{copy.todayTitleFirst}<br>{copy.todayTitleSecond}</h2>
            <svg class="dinner-art" viewBox="0 0 420 190" role="img" aria-label={copy.dinnerAlt}><use href={sitePath('/editorial/illustrations.svg#dinner')}/></svg>
            <p>{copy.todayDescription}</p>
            <a class="note-source" href={localPath('resources/romeo-2018-conversational-turns/')}>{copy.todayResearch} <span aria-hidden="true">↗</span></a>
            <div class="source-details note-details"><span>{copy.todayEvidence}</span><span>{copy.checked} <time datetime="2026-11-13">2026-11-13</time></span></div>
          </article>
          <div class="editor-desk"><span class="eyebrow">{copy.wondering}</span><a href={localPath('topics/screen-time/')}>{copy.screenQuestion}<span aria-hidden="true">↗</span></a><a href={localPath('topics/social-media/')}>{copy.mediaQuestion}<span aria-hidden="true">↗</span></a></div>
        </aside>
      </section>

      <section id="ages" class="age-section section-space" aria-labelledby="age-title">
        <div class="section-heading"><div><span class="eyebrow">EVERY AGE, A NEW CHAPTER</span><h2 id="age-title">{copy.ageTitle}</h2></div><p>{copy.ageDescription}</p></div>
        <div class="age-grid">
          <a class="age-item" href={localPath('ages/babies/')}><span class="age-range">{copy.babyRange}</span><svg viewBox="0 0 200 120" role="img" aria-label={copy.babyAlt}><use href={sitePath('/editorial/illustrations.svg#baby')}/></svg><h3>{copy.babyTitle}<span aria-hidden="true">↗</span></h3><p>{copy.babyDescription}</p></a>
          <a class="age-item" href={localPath('ages/toddlers/')}><span class="age-range">{copy.toddlerRange}</span><svg viewBox="0 0 200 120" role="img" aria-label={copy.toddlerAlt}><use href={sitePath('/editorial/illustrations.svg#toddler')}/></svg><h3>{copy.toddlerTitle}<span aria-hidden="true">↗</span></h3><p>{copy.toddlerDescription}</p></a>
          <a class="age-item" href={localPath('ages/preschoolers/')}><span class="age-range">{copy.preschoolRange}</span><svg viewBox="0 0 200 120" role="img" aria-label={copy.preschoolAlt}><use href={sitePath('/editorial/illustrations.svg#preschool')}/></svg><h3>{copy.preschoolTitle}<span aria-hidden="true">↗</span></h3><p>{copy.preschoolDescription}</p></a>
          <a class="age-item" href={localPath('ages/school-age/')}><span class="age-range">{copy.schoolRange}</span><svg viewBox="0 0 200 120" role="img" aria-label={copy.schoolAlt}><use href={sitePath('/editorial/illustrations.svg#school')}/></svg><h3>{copy.schoolTitle}<span aria-hidden="true">↗</span></h3><p>{copy.schoolDescription}</p></a>
          <a class="age-item" href={localPath('ages/teens/')}><span class="age-range">{copy.teenRange}</span><svg viewBox="0 0 200 120" role="img" aria-label={copy.teenAlt}><use href={sitePath('/editorial/illustrations.svg#teen')}/></svg><h3>{copy.teenTitle}<span aria-hidden="true">↗</span></h3><p>{copy.teenDescription}</p></a>
        </div>
      </section>

      <section id="topics" class="topics-section section-space" aria-labelledby="topics-title">
        <div class="section-heading"><div><span class="eyebrow">QUESTIONS WE SHARE</span><h2 id="topics-title">{copy.topicsTitle}</h2></div><a class="text-link" href={localPath('topics/')}>{copy.allTopics} <span aria-hidden="true">↗</span></a></div>
        <div class="topic-grid">
          <article class="topic-story"><a class="topic-image screen-art" href={localPath('topics/screen-time/')} aria-label={copy.screenLabel}><svg viewBox="0 0 400 225" role="img" aria-label={copy.screenAlt}><use href={sitePath('/editorial/illustrations.svg#screens')}/></svg></a><span class="eyebrow">{copy.screenCategory}</span><h3><a href={localPath('topics/screen-time/')}>{copy.screenTitleFirst}<br>{copy.screenTitleSecond}</a></h3><p>{copy.screenDescription}</p><span class="article-meta">{copy.screenEvidence}<time datetime="2026-11-13">{copy.contentDate}</time></span></article>
          <article class="topic-story"><a class="topic-image media-art" href={localPath('topics/social-media/')} aria-label={copy.mediaLabel}><svg viewBox="0 0 400 225" role="img" aria-label={copy.mediaAlt}><use href={sitePath('/editorial/illustrations.svg#social')}/></svg></a><span class="eyebrow">{copy.mediaCategory}</span><h3><a href={localPath('topics/social-media/')}>{copy.mediaTitleFirst}<br>{copy.mediaTitleSecond}</a></h3><p>{copy.mediaDescription}</p><span class="article-meta">{copy.mediaEvidence}<time datetime="2026-11-13">{copy.contentDate}</time></span></article>
          <article class="topic-story"><a class="topic-image reading-art" href={localPath('resources/nurturing-care-framework-2018/')} aria-label={copy.respondLabel}><svg viewBox="0 0 400 225" role="img" aria-label={copy.respondAlt}><use href={sitePath('/editorial/illustrations.svg#respond')}/></svg></a><span class="eyebrow">{copy.respondCategory}</span><h3><a href={localPath('resources/nurturing-care-framework-2018/')}>{copy.respondTitleFirst}<br>{copy.respondTitleSecond}</a></h3><p>{copy.respondDescription}</p><span class="article-meta">{copy.respondEvidence}<time datetime="2026-11-13">{copy.checkedDate}</time></span></article>
        </div>
      </section>
    </div>

    <section class="reading-band" id="reading" aria-labelledby="reading-title">
      <div class="wrap reading-layout"><div class="reading-intro"><span class="eyebrow">A SMALL, THOUGHTFUL SHELF</span><h2 id="reading-title">{copy.shelfTitleFirst}<br>{copy.shelfTitleSecond}</h2><p>{copy.shelfIntroFirst}<br>{copy.shelfIntroSecond}<br>{copy.shelfIntroThird}</p><a class="text-link" href={localPath('library/')}>{copy.library} <span aria-hidden="true">↗</span></a></div>
        <div class="reading-list"><a class="reading-row" href={localPath('resources/faber-mazlish-kids/')}><span class="resource-number">01</span><div><span class="resource-kind">{copy.bookKind}</span><h3>{copy.bookTitleFirst}<br class="desktop-break">{copy.bookTitleSecond}</h3><p>Adele Faber & Elaine Mazlish</p><p class="resource-checked">{copy.checked} <time datetime="2026-11-13">2026-11-13</time></p></div><span class="row-arrow" aria-hidden="true">↗</span></a><a class="reading-row" href={localPath('resources/aap-family-media-plan/')}><span class="resource-number">02</span><div><span class="resource-kind">{copy.planKind}</span><h3>{copy.planTitle}</h3><p>{copy.planBy}</p><p class="resource-checked">{copy.checked} <time datetime="2026-11-13">2026-11-13</time></p></div><span class="row-arrow" aria-hidden="true">↗</span></a><a class="reading-row" href={localPath('resources/nurturing-care-framework-2018/')}><span class="resource-number">03</span><div><span class="resource-kind">{copy.frameworkKind}</span><h3>{copy.frameworkTitle}</h3><p>WHO · UNICEF · World Bank Group</p><p class="resource-checked">{copy.checked} <time datetime="2026-11-13">2026-11-13</time></p></div><span class="row-arrow" aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="trust-section wrap" id="about" aria-labelledby="trust-title"><div class="trust-intro"><svg class="sprout" viewBox="0 0 60 70" aria-hidden="true"><path d="M29 64V30M29 43C6 43 5 23 7 18c20 0 25 13 22 25ZM29 31C29 10 44 5 54 6c0 17-8 27-25 25Z"/></svg><h2 id="trust-title">{copy.trustTitleFirst}<br>{copy.trustTitleSecond}</h2></div><div class="trust-points"><div><h3>{copy.sourcesTitle}</h3><p>{copy.sourcesDescription}</p></div><div><h3>{copy.privacyTitle}</h3><p>{copy.privacyDescription}</p></div></div></section>
  </main>

  <footer class="site-footer"><div class="wrap footer-inner"><a class="footer-brand" href={homeUrl}>Edustack<span>{copy.tagline}</span></a><p>{copy.footerNote}</p><div><a href="#about">{copy.about}</a> · <a href="https://archive.edustack.org/">{copy.archive}</a><span>{copy.disclaimer}</span></div></div></footer>
  
</body>
</html>

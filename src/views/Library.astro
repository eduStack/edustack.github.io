---
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { recommendations as resources, type Lang } from '../lib/data';
import { t, href } from '../i18n/ui';
import { resourceTopics } from '../lib/taxonomy.mjs';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const zh = lang === 'zh';
const used = [...new Set(resources.flatMap((r) => r.topics))];
const sorted = [...resources].sort((a, b) => a.minMonths - b.minMonths);
---
<Base lang={lang} title={s.nav.library} active="library">
<main id="main" tabindex="-1" class="wrap" style="padding-top:32px;display:flex;flex-direction:column;gap:20px">
  <div class="split" style="align-items:flex-end">
    <div class="stack" style="gap:6px">
      <h1 class="h-serif" style="font-size:var(--type-feature)">{s.nav.library}</h1>
      <span class="muted" style="font-size:var(--type-ui)">{zh ? `共 ${resources.length} 条书籍、经典导读、实用资源和指南，附原始出处与核验记录。相关研究可在资源和阶段页面查看。` : `${resources.length} books, classic readings, practical resources and guidelines, with original sources and check records. Related research appears on resource and age-stage pages.`}</span>
    </div>
    <div class="row" style="gap:8px"><label for="sort" class="muted">{zh ? '排序' : 'Sort'}</label>
      <select id="sort"><option value="age">{zh ? '按年龄' : 'By age'}</option><option value="year">{zh ? '发表时间（最新在前）' : 'Newest first'}</option></select></div>
  </div>
  <div class="row" style="gap:8px" role="group" aria-label={zh ? '资源类型' : 'Resource type'} id="types">
    <button class="pill" type="button" data-type="" aria-pressed="true">{zh ? '全部' : 'All'}</button>
    {(['book', 'classic', 'guide', 'guideline'] as const).map((k) => <button class="pill" type="button" data-type={k} aria-pressed="false">{s.typePlural[k]}</button>)}
  </div>
  <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start">
    <aside class="card" style="flex:1 1 240px;gap:18px" aria-label={zh ? '筛选' : 'Filters'}>
      <div class="stack" style="gap:6px"><label for="q" style="font-weight:600">{zh ? '搜索' : 'Search'}</label><input id="q" type="search" /></div>
      <div class="stack" style="gap:6px"><label for="age" style="font-weight:600">{zh ? '孩子年龄' : "Child's age"}</label>
        <select id="age"><option value="">{zh ? '不限年龄' : 'Any age'}</option></select>
        <span class="muted" style="font-size:var(--type-note)">{zh ? '只显示适用年龄包含这个月龄的资源。' : 'Shows resources whose age range includes this age.'}</span></div>
      <div class="stack" style="gap:6px"><label for="topic" style="font-weight:600">{zh ? '主题' : 'Topic'}</label>
        <select id="topic"><option value="">{zh ? '全部主题' : 'All topics'}</option>{used.map((k) => <option value={k}>{resourceTopics[k][lang]}</option>)}</select></div>
      <label class="row" style="gap:8px;min-height:2.75rem"><input type="checkbox" id="free" /> {zh ? '只看可免费阅读的' : 'Free to read only'}</label>
      <a href={href(lang, 'tools')}>{zh ? '找免费学习工具？' : 'Looking for free learning tools?'}</a>
    </aside>
    <section style="flex:999 1 600px;min-width:0" class="stack" aria-live="polite">
      <div class="muted" style="font-size:var(--type-note)" id="count"></div>
      <div class="stack" id="list">{sorted.map((r) => <ResourceCard r={r} lang={lang} />)}</div>
      <p id="empty" class="card" hidden>{zh ? '没有符合条件的资源。试试放宽筛选条件。' : 'No resources match. Try fewer filters.'}</p>
    </section>
  </div>
</main>
<script>
  import { load, ageMonths, ageText } from '../lib/client';
  const lang = document.body.dataset.lang || 'en';
  const zh = lang === 'zh';
  const list = document.getElementById('list')!;
  const cards = [...list.querySelectorAll('article')] as HTMLElement[];
  const q = document.getElementById('q') as HTMLInputElement;
  const age = document.getElementById('age') as HTMLSelectElement;
  const topic = document.getElementById('topic') as HTMLSelectElement;
  const free = document.getElementById('free') as HTMLInputElement;
  const sort = document.getElementById('sort') as HTMLSelectElement;
  const types = [...document.querySelectorAll('#types .pill')] as HTMLButtonElement[];
  let type = '';
  const store = load();
  store.children.forEach((c, i) => {
    const mo = ageMonths(c);
    const o = new Option(`${c.name || (zh ? `孩子 ${i + 1}` : `Child ${i + 1}`)} · ${ageText(mo, lang)}`, String(mo));
    o.dataset.sex = c.sex;
    age.add(o);
  });
  for (const [mo, en, z] of [[6, '6 months', '6 个月'], [24, '2 years', '2 岁'], [48, '4 years', '4 岁'], [96, '8 years', '8 岁'], [168, '14 years', '14 岁']] as const) age.add(new Option(zh ? z : en, String(mo)));
  if (store.children.length) age.selectedIndex = 1;
  q.value = new URLSearchParams(location.search).get('q') || '';
  function apply() {
    const term = q.value.trim().toLowerCase();
    const mo = age.value === '' ? null : Number(age.value);
    const sex = age.selectedOptions[0]?.dataset.sex || '';
    let n = 0;
    for (const c of cards) {
      const d = c.dataset;
      const ok = (!type || d.type === type)
        && (mo === null || (mo >= Number(d.min) && mo <= Number(d.max)))
        && (!topic.value || (d.topics || '').split(' ').includes(topic.value))
        && (!free.checked || d.free === '1')
        && (d.sex === 'all' || !sex || d.sex === sex)
        && (!term || (c.textContent || '').toLowerCase().includes(term));
      c.hidden = !ok; if (ok) n++;
    }
    const sorted = [...cards].sort((a, b) => sort.value === 'year' ? Number(b.dataset.year) - Number(a.dataset.year) : Number(a.dataset.min) - Number(b.dataset.min));
    sorted.forEach((c) => list.appendChild(c));
    document.getElementById('count')!.textContent = zh ? `显示 ${n} 条` : `Showing ${n}`;
    document.getElementById('empty')!.hidden = n > 0;
  }
  types.forEach((b) => b.addEventListener('click', () => { type = b.dataset.type || ''; types.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); apply(); }));
  [q, age, topic, free, sort].forEach((el) => el.addEventListener('input', apply));
  apply();
</script>
</Base>

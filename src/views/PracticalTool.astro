---
import Base from '../layouts/Base.astro';
import { href } from '../i18n/ui';
import type { Lang } from '../lib/data';

interface Props { lang: Lang; kind: 'growth-chart' | 'daily-routine' | 'milestones' | 'screen-agreement' }
const { lang, kind } = Astro.props;
const zh = lang === 'zh';
const copy = {
  'growth-chart': zh ? { title: '生长曲线记录', intro: '记录一次身高和体重，先看清数据，再带着记录向专业人员询问。这里不计算诊断性的百分位。', age: '年龄（岁）', sex: '性别', height: '身高（厘米）', weight: '体重（公斤）', calculate: '计算体重指数', result: '记录结果', note: '体重指数只是一个粗略的数学指标，儿童的生长需要结合年龄、性别、趋势和专业曲线判断。不要根据本工具自行诊断。', male: '男', female: '女', source: '依据与限制', sourceText: '参考 WHO 儿童生长标准的使用思路；本第一版只计算 BMI，不替代 WHO 曲线、体检或医生判断。' } : { title: 'Growth record', intro: 'Record one height and weight measurement, then take the record to a professional if you have questions. This first version does not calculate diagnostic percentiles.', age: 'Age (years)', sex: 'Sex', height: 'Height (cm)', weight: 'Weight (kg)', calculate: 'Calculate BMI', result: 'Recorded result', note: 'BMI is only a rough mathematical measure. Children’s growth needs age, sex, trajectory and a professional growth chart. Do not diagnose from this tool.', male: 'Male', female: 'Female', source: 'Basis and limits', sourceText: 'Informed by how WHO child growth standards are used. This first version calculates BMI only; it does not replace a WHO chart, check-up or clinician.' },
  'daily-routine': zh ? { title: '一天的作息对照', intro: '把睡眠、活动和屏幕时间放在一起看，帮助全家讨论一天的安排。', age: '孩子年龄（岁）', sleep: '睡眠（小时）', activity: '活动（分钟）', screen: '娱乐屏幕（小时）', check: '查看对照', result: '今天的对照', source: '依据与限制', sourceText: '参考 WHO 身体活动与久坐行为指南、AASM 睡眠建议和家庭媒体讨论原则。指标是讨论起点，不是对孩子的评分。' } : { title: 'A day at a glance', intro: 'Put sleep, movement and recreational screen time together so your family can discuss the day.', age: 'Child age (years)', sleep: 'Sleep (hours)', activity: 'Movement (minutes)', screen: 'Recreational screen time (hours)', check: 'Check the day', result: 'Today’s comparison', source: 'Basis and limits', sourceText: 'Informed by WHO movement guidance, AASM sleep recommendations and family media discussions. These are conversation starters, not a score.' },
  'milestones': zh ? { title: '发育里程碑清单', intro: '选择一个年龄段，勾选你已经观察到的日常表现，并把疑问记下来。清单不能用来筛查或诊断。', age: '年龄段', check: '已观察到', question: '想带去询问的问题', save: '保存清单', result: '当前记录', source: '依据与限制', sourceText: '参考 CDC 发育里程碑公开清单的表达方式，并做了原创改写。孩子发展有个体差异；如果担心，请向儿科或当地专业机构咨询。' } : { title: 'Milestone checklist', intro: 'Choose an age band, tick everyday behaviours you have observed and note questions to bring to a professional. This is not a screening or diagnostic tool.', age: 'Age band', check: 'Observed', question: 'Questions to bring', save: 'Save checklist', result: 'Your record', source: 'Basis and limits', sourceText: 'Informed by the public CDC milestone checklist format and rewritten by eduStack. Development varies; contact a paediatric or local professional service if you are concerned.' },
  'screen-agreement': zh ? { title: '家庭屏幕约定', intro: '和孩子一起写下适合你们家庭的屏幕使用约定，打印出来再一起调整。', name: '孩子姓名或称呼', place: '屏幕使用的地方', time: '我们约定的时间', before: '使用前先做什么', after: '结束后做什么', adult: '成人也会做到', print: '打印约定', source: '依据与限制', sourceText: '参考美国儿科学会家庭媒体计划的讨论方向。这里生成的是家庭自己的约定，不是医疗或教育机构的统一规则。' } : { title: 'Family screen agreement', intro: 'Write a screen agreement that fits your family, print it and adjust it together over time.', name: 'Child’s name or nickname', place: 'Where screens are used', time: 'Our agreed times', before: 'What we do first', after: 'What we do after', adult: 'What adults will do too', print: 'Print agreement', source: 'Basis and limits', sourceText: 'Informed by the American Academy of Pediatrics Family Media Plan discussion areas. This creates a family agreement, not a universal medical or school rule.' },
};
const c: any = copy[kind];
const milestoneSets = zh ? {
  baby: ['对熟悉的人有回应', '会用声音或动作表达需要', '能短暂保持坐姿或移动身体', '会拿取、观察或传递物品'], toddler: ['能听懂简单指令', '会用词语或动作表达选择', '会尝试自己吃饭或穿脱简单衣物', '会和成人进行来回游戏'], preschool: ['能讲述一件熟悉的事', '会和其他孩子一起玩或轮流', '能完成两步或三步的小任务', '会表达情绪并在帮助下平静下来'], school: ['能说明自己的想法和理由', '能在提醒下安排一项任务', '会与同伴协商规则或解决分歧', '能在困难后尝试调整方法']
} : {
  baby: ['Responds to familiar people', 'Uses sounds or actions to communicate needs', 'Briefly holds a sitting or moving position', 'Reaches for, watches or passes objects'], toddler: ['Follows a simple direction', 'Uses words or actions to make a choice', 'Tries simple self-care such as eating or dressing', 'Takes turns in a back-and-forth game'], preschool: ['Tells something about a familiar event', 'Plays with another child or takes turns', 'Completes a two- or three-step task', 'Names a feeling and settles with help'], school: ['Explains an idea or reason', 'Plans a task with a reminder', 'Negotiates a rule or disagreement with a peer', 'Tries a different approach after difficulty']
};
const labels = JSON.stringify(c);
const milestones = JSON.stringify(milestoneSets);
---
<Base lang={lang} title={c.title} description={c.intro} active="tools">
<main id="main" tabindex="-1" class="practical-tool wrap">
  <nav class="row muted"><a href={href(lang, 'tools/')}>{zh ? '返回工具目录' : 'Back to tools'}</a><span aria-hidden="true">/</span><span>{c.title}</span></nav>
  <header class="stack intro"><div class="chips"><span class="chip t-tool">{zh ? '本站工具' : 'eduStack tool'}</span><span class="chip">{zh ? '第一版' : 'First version'}</span></div><h1 class="h-serif">{c.title}</h1><p class="prose">{c.intro}</p><p class="muted privacy-note">{zh ? '内容只在当前浏览器中处理，不写入孩子档案或网址。' : 'Values are processed in this browser and are not written to a child profile or URL.'}</p></header>
  {kind === 'growth-chart' && <section class="tool-panel"><div class="fields"><label>{c.age}<input data-age type="number" min="0" max="19" step="0.1" /></label><label>{c.sex}<select data-sex><option>{c.male}</option><option>{c.female}</option></select></label><label>{c.height}<input data-height type="number" min="30" max="230" step="0.1" /></label><label>{c.weight}<input data-weight type="number" min="1" max="200" step="0.1" /></label></div><button class="btn btn-primary" data-calculate>{c.calculate}</button><div class="result" data-result aria-live="polite"></div></section>}
  {kind === 'daily-routine' && <section class="tool-panel"><div class="fields"><label>{c.age}<input data-age type="number" min="0" max="18" step="1" /></label><label>{c.sleep}<input data-sleep type="number" min="0" max="24" step="0.5" /></label><label>{c.activity}<input data-activity type="number" min="0" max="1000" step="5" /></label><label>{c.screen}<input data-screen type="number" min="0" max="24" step="0.5" /></label></div><button class="btn btn-primary" data-check>{c.check}</button><div class="result" data-result aria-live="polite"></div></section>}
  {kind === 'milestones' && <section class="tool-panel"><label>{c.age}<select data-band><option value="baby">{zh ? '宝宝（约 0–1 岁）' : 'Baby (about 0–1)'}</option><option value="toddler">{zh ? '幼儿（约 1–3 岁）' : 'Toddler (about 1–3)'}</option><option value="preschool">{zh ? '学龄前（约 3–5 岁）' : 'Preschool (about 3–5)'}</option><option value="school">{zh ? '学龄期（约 6–12 岁）' : 'School age (about 6–12)'}</option></select></label><div class="checks" data-checks></div><label>{c.question}<textarea data-question maxlength="500"></textarea></label><button class="btn btn-primary" data-save>{c.save}</button><div class="result" data-result aria-live="polite"></div></section>}
  {kind === 'screen-agreement' && <section class="tool-panel agreement"><label>{c.name}<input data-name maxlength="60" /></label><label>{c.place}<textarea data-place maxlength="240"></textarea></label><label>{c.time}<textarea data-time maxlength="240"></textarea></label><label>{c.before}<textarea data-before maxlength="240"></textarea></label><label>{c.after}<textarea data-after maxlength="240"></textarea></label><label>{c.adult}<textarea data-adult maxlength="240"></textarea></label><button class="btn btn-primary" data-print>{c.print}</button></section>}
  <section class="card basis"><h2>{c.source}</h2><p class="prose">{c.sourceText}</p></section>
</main>
</Base>
<script define:vars={{ kind, labels, milestones }}>{`
const c = JSON.parse(labels), sets = JSON.parse(milestones), root = document.querySelector('.practical-tool');
const out = root.querySelector('[data-result]');
const n = (sel) => Number(root.querySelector(sel)?.value || 0);
const text = (value) => value ? String(value) : (${JSON.stringify(zh ? '未填写' : 'Not filled')});
if (kind === 'growth-chart') root.querySelector('[data-calculate]').addEventListener('click', () => { const bmi = n('[data-weight]') / ((n('[data-height]') / 100) ** 2); out.innerHTML = '<strong>' + c.result + '</strong><p>' + c.age + ': ' + text(n('[data-age]')) + ' · ' + c.sex + ': ' + root.querySelector('[data-sex]').value + '</p><p>BMI: ' + (Number.isFinite(bmi) && bmi > 0 ? bmi.toFixed(1) : text('')) + '</p><p class="muted">' + c.note + '</p>'; });
if (kind === 'daily-routine') root.querySelector('[data-check]').addEventListener('click', () => { const age=n('[data-age]'), sleep=n('[data-sleep]'), activity=n('[data-activity]'), screen=n('[data-screen]'); const sleepTarget=age<1?14:age<3?13:age<6?11:age<13?10:8; const sleepOk=sleep>=sleepTarget-2, moveOk=age<5?activity>=180:activity>=60, screenOk=screen<=2; out.innerHTML='<strong>'+c.result+'</strong><ul><li>'+c.sleep+': '+sleep+' · '+(sleepOk?'✓':'△')+'</li><li>'+c.activity+': '+activity+' · '+(moveOk?'✓':'△')+'</li><li>'+c.screen+': '+screen+' · '+(screenOk?'✓':'△')+'</li></ul><p class="muted">'+(${JSON.stringify(zh ? '△ 只是提醒你进一步讨论，不是评分。' : '△ is a prompt for discussion, not a score.')})+'</p>'; });
if (kind === 'milestones') { const checks=root.querySelector('[data-checks]'), render=()=>{ checks.replaceChildren(...sets[root.querySelector('[data-band]').value].map((item,i)=>{ const label=document.createElement('label'); label.className='check-row'; label.innerHTML='<input type="checkbox"> <span>'+item+'</span>'; return label; })); }; root.querySelector('[data-band]').addEventListener('change',render); render(); root.querySelector('[data-save]').addEventListener('click',()=>{ out.textContent=c.result+'：'+[...checks.querySelectorAll('input')].filter(x=>x.checked).length+'/'+checks.querySelectorAll('input').length; }); }
if (kind === 'screen-agreement') root.querySelector('[data-print]').addEventListener('click',()=>window.print());
`}</script>
<style>
  .practical-tool { padding-block:2rem 4rem; display:flex; flex-direction:column; gap:2rem; } .intro { max-width:54rem; } .privacy-note { border-inline-start:3px solid var(--accent); padding-inline-start:.75rem; }
  .tool-panel { max-width:56rem; display:flex; flex-direction:column; gap:1.25rem; padding:clamp(1rem,3vw,2rem); border:1px solid var(--line); background:var(--paper); } .fields { display:grid; grid-template-columns:repeat(auto-fit,minmax(12rem,1fr)); gap:1rem; } label { display:flex; flex-direction:column; gap:.4rem; font-weight:600; } input,select,textarea { font:inherit; color:var(--ink); background:var(--paper); border:1px solid var(--line-strong); padding:.65rem .75rem; border-radius:0; font-weight:400; } textarea { min-height:5rem; resize:vertical; } .result { min-height:3rem; border-top:1px solid var(--line); padding-top:1rem; } .result p,.result ul { margin:.5rem 0; } .checks { display:flex; flex-direction:column; gap:.7rem; } .check-row { flex-direction:row; align-items:flex-start; font-weight:400; } .agreement { max-width:45rem; } .basis { max-width:56rem; }
  @media print { .practical-tool { padding:0; } .practical-tool > nav,.practical-tool .privacy-note,.practical-tool .chips,.practical-tool .btn,.practical-tool .basis { display:none; } .tool-panel { border:0; padding:0; } input,textarea,select { border:0; padding-inline:0; } }
</style>

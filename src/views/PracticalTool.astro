---
import Base from '../layouts/Base.astro';
import { href } from '../i18n/ui';
import { getTool, type Lang } from '../lib/data';
import ToolContext from '../components/ToolContext.astro';
import { dailyGuidance } from '../lib/daily-guidance.mjs';

interface Props { lang: Lang; kind: 'growth-chart' | 'daily-routine' | 'milestones' | 'screen-agreement' }
const { lang, kind } = Astro.props;
const zh = lang === 'zh';
const tool = getTool(kind);
const copy = {
  'growth-chart': zh ? { age: '年龄（岁）', sex: '性别', height: '身高（厘米）', weight: '体重（公斤）', calculate: '计算体重指数', result: '记录结果', note: '体重指数只是一个粗略的数学指标，儿童的生长需要结合年龄、性别、趋势和专业曲线判断。不要根据本工具自行诊断。', male: '男', female: '女', } : { age: 'Age (years)', sex: 'Sex', height: 'Height (cm)', weight: 'Weight (kg)', calculate: 'Calculate BMI', result: 'Recorded result', note: 'BMI is only a rough mathematical measure. Children’s growth needs age, sex, trajectory and a professional growth chart. Do not diagnose from this tool.', male: 'Male', female: 'Female', },
  'daily-routine': zh ? { age: '孩子年龄（岁）', sleep: '睡眠（小时）', activity: '活动（分钟）', screen: '娱乐屏幕（小时）', check: '查看对照', result: '今天的对照', range: '参考范围', discussion: '讨论提示', } : { age: 'Child age (years)', sleep: 'Sleep (hours)', activity: 'Movement (minutes)', screen: 'Recreational screen time (hours)', check: 'Check the day', result: 'Today’s comparison', range: 'Reference range', discussion: 'Discussion prompt', },
  'milestones': zh ? { age: '年龄段', check: '已观察到', question: '想带去询问的问题', save: '保存清单', result: '当前记录', saved: '已保存到这台浏览器。', saveError: '保存失败，当前内容仍可继续编辑。', overwriteConfirm: '另一个标签页更新了记录。仍要用当前内容覆盖吗？', externalChange: '另一个标签页更新了记录；请先保存或恢复。', leaveConfirm: '当前有未保存修改，确定离开吗？', } : { age: 'Age band', check: 'Observed', question: 'Questions to bring', save: 'Save checklist', result: 'Your record', saved: 'Saved in this browser.', saveError: 'Saving failed. You can keep editing this list.', overwriteConfirm: 'Another tab updated this record. Overwrite it with this draft?', externalChange: 'Another tab updated this record; save or restore before continuing.', leaveConfirm: 'You have unsaved changes. Leave this page?', },
  'screen-agreement': zh ? { name: '孩子姓名或称呼', place: '屏幕使用的地方', time: '我们约定的时间', before: '使用前先做什么', after: '结束后做什么', adult: '成人也会做到', save: '保存到本机', clear: '清除本机保存', clearConfirm: '清除这份屏幕约定？', saved: '已保存到这台浏览器。', saveError: '保存失败，当前内容仍可继续编辑或打印。', overwriteConfirm: '另一个标签页更新了记录。仍要用当前内容覆盖吗？', externalChange: '另一个标签页更新了记录；请先保存或恢复。', leaveConfirm: '当前有未保存修改，确定离开吗？', print: '打印约定', } : { name: 'Child’s name or nickname', place: 'Where screens are used', time: 'Our agreed times', before: 'What we do first', after: 'What we do after', adult: 'What adults will do too', save: 'Save on this device', clear: 'Clear device save', clearConfirm: 'Clear this screen agreement?', saved: 'Saved in this browser.', saveError: 'Saving failed. You can keep editing or print the current agreement.', overwriteConfirm: 'Another tab updated this agreement. Overwrite it with this draft?', externalChange: 'Another tab updated this agreement; save or restore before continuing.', leaveConfirm: 'You have unsaved changes. Leave this page?', print: 'Print agreement', },
};
const c: any = { ...copy[kind], title: tool.name[lang], intro: tool.what[lang],
  unsaved: zh ? '有未保存的修改。' : 'You have unsaved changes.',
  invalid: zh ? '请先检查输入' : 'Check the entries first',
  invalidText: zh ? '请填写必需的数值，并按输入框提示检查范围。未满 1 岁请补充月龄。' : 'Fill in the required values and check the allowed ranges. For a child under one, enter their age in months.',
};
const milestoneSets = zh ? {
  baby: ['对熟悉的人有回应', '会用声音或动作表达需要', '能短暂保持坐姿或移动身体', '会拿取、观察或传递物品'], toddler: ['能听懂简单指令', '会用词语或动作表达选择', '会尝试自己吃饭或穿脱简单衣物', '会和成人进行来回游戏'], preschool: ['能讲述一件熟悉的事', '会和其他孩子一起玩或轮流', '能完成两步或三步的小任务', '会表达情绪并在帮助下平静下来'], school: ['能说明自己的想法和理由', '能在提醒下安排一项任务', '会与同伴协商规则或解决分歧', '能在困难后尝试调整方法']
} : {
  baby: ['Responds to familiar people', 'Uses sounds or actions to communicate needs', 'Briefly holds a sitting or moving position', 'Reaches for, watches or passes objects'], toddler: ['Follows a simple direction', 'Uses words or actions to make a choice', 'Tries simple self-care such as eating or dressing', 'Takes turns in a back-and-forth game'], preschool: ['Tells something about a familiar event', 'Plays with another child or takes turns', 'Completes a two- or three-step task', 'Names a feeling and settles with help'], school: ['Explains an idea or reason', 'Plans a task with a reminder', 'Negotiates a rule or disagreement with a peer', 'Tries a different approach after difficulty']
};
const labels = JSON.stringify(c);
const milestones = JSON.stringify(milestoneSets);
const dailyRulesJSON = JSON.stringify(dailyGuidance);
---
<Base lang={lang} title={c.title} description={c.intro} active="tools">
<main id="main" tabindex="-1" class="practical-tool wrap">
  <nav class="row muted"><a href={href(lang, 'tools/')}>{zh ? '返回工具目录' : 'Back to tools'}</a><span aria-hidden="true">/</span><span>{c.title}</span></nav>
  <header class="stack intro"><div class="chips"><span class="chip t-tool">{zh ? '本站工具' : 'eduStack tool'}</span><span class="chip">{zh ? '第一版' : 'First version'}</span></div><h1 class="h-serif">{c.title}</h1><p class="prose">{c.intro}</p><p class="muted privacy-note">{zh ? '内容只在当前浏览器中处理，不写入孩子档案或网址。' : 'Values are processed in this browser and are not written to a child profile or URL.'}</p></header>
  <p class="callout" data-tool-unavailable>{zh ? '请开启 JavaScript 并重新加载页面以使用工具。下方的用途和依据仍可阅读。' : 'Enable JavaScript and reload this page to use the tool. Its purpose and sources remain readable below.'}</p>
  {kind === 'growth-chart' && <fieldset disabled data-tool-controls aria-label={c.title} class="tool-panel"><p class="muted">{zh ? '身高、体重必填。年龄与性别为可选记录，不参与本工具的 BMI 计算。' : 'Height and weight are required. Age and sex are optional notes and do not affect this tool’s BMI calculation.'}</p><div class="fields"><label>{c.age}<input data-age type="number" min="0" max="17.9" step="0.1" /><span class="print-value" data-print-field="age"></span></label><label>{c.sex}<select data-sex><option value="">{zh ? '未填写' : 'Not filled'}</option><option>{c.male}</option><option>{c.female}</option></select><span class="print-value" data-print-field="sex"></span></label><label>{c.height}<input data-height type="number" min="30" max="230" step="0.1" required /><span class="print-value" data-print-field="height"></span></label><label>{c.weight}<input data-weight type="number" min="1" max="200" step="0.1" required /><span class="print-value" data-print-field="weight"></span></label></div><button class="btn btn-primary" data-calculate>{c.calculate}</button><div class="result" data-result aria-live="polite"></div></fieldset>}
  {kind === 'daily-routine' && <fieldset disabled data-tool-controls aria-label={c.title} class="tool-panel"><div class="fields"><label>{c.age}<input data-age type="number" min="0" max="17" step="1" required /><span class="print-value" data-print-field="age"></span></label><label hidden>{zh ? '月龄（未满 1 岁）' : 'Age in months (under one)'}<input data-age-months type="number" min="0" max="11" step="1" disabled /><span class="print-value" data-print-field="age-months"></span></label><label>{c.sleep}<input data-sleep type="number" min="0" max="24" step="0.5" required /><span class="print-value" data-print-field="sleep"></span></label><label>{c.activity}<input data-activity type="number" min="0" max="1440" step="1" required /><span class="print-value" data-print-field="activity"></span></label><label>{c.screen}<input data-screen type="number" min="0" max="24" step="0.5" required /><span class="print-value" data-print-field="screen"></span></label></div><button class="btn btn-primary" data-check>{c.check}</button><div class="result" data-result aria-live="polite"></div></fieldset>}
  {kind === 'milestones' && <fieldset disabled data-tool-controls aria-label={c.title} class="tool-panel"><label>{c.age}<select data-band><option value="baby">{zh ? '宝宝（未满 1 岁）' : 'Baby (under one)'}</option><option value="toddler">{zh ? '幼儿（1–2 岁）' : 'Toddler (1–2)'}</option><option value="preschool">{zh ? '学龄前（约 3–5 岁）' : 'Preschool (about 3–5)'}</option><option value="school">{zh ? '学龄期（约 6–12 岁）' : 'School age (about 6–12)'}</option></select><span class="print-value" data-print-band></span></label><div class="checks" data-checks></div><label>{c.question}<textarea data-question maxlength="500"></textarea><span class="print-value" data-print="question"></span></label><button class="btn btn-primary" data-save>{c.save}</button><div class="result" data-result aria-live="polite"></div></fieldset>}
  {kind === 'screen-agreement' && <fieldset disabled data-tool-controls aria-label={c.title} class="tool-panel agreement"><label>{c.name}<input data-name maxlength="60" /><span class="print-value" data-print="name"></span></label><label>{c.place}<textarea data-place maxlength="240"></textarea><span class="print-value" data-print="place"></span></label><label>{c.time}<textarea data-time maxlength="240"></textarea><span class="print-value" data-print="time"></span></label><label>{c.before}<textarea data-before maxlength="240"></textarea><span class="print-value" data-print="before"></span></label><label>{c.after}<textarea data-after maxlength="240"></textarea><span class="print-value" data-print="after"></span></label><label>{c.adult}<textarea data-adult maxlength="240"></textarea><span class="print-value" data-print="adult"></span></label><div class="tool-actions"><button class="btn btn-primary" data-save>{c.save}</button><button class="btn" data-clear>{c.clear}</button><button class="btn" data-print>{c.print}</button></div><div class="result" data-result aria-live="polite"></div></fieldset>}
  <ToolContext tool={tool} lang={lang} />
  {tool.limits && <p class="print-only">{tool.limits[lang]}</p>}
</main>
</Base>
<script define:vars={{ kind, labels, milestones, dailyRulesJSON, storageKey: `edustack.${kind}.v1` }}>
  const c = JSON.parse(labels);
  const sets = JSON.parse(milestones);
  const root = document.querySelector('.practical-tool');
  const out = root?.querySelector('[data-result]');
  let dirty = false;
  let externalChange = false;
  const markDirty = () => { dirty = true; out.textContent = externalChange ? c.externalChange : c.unsaved; window.dispatchEvent(new CustomEvent('edustack:dirty')); };
  const markClean = () => { dirty = false; externalChange = false; window.dispatchEvent(new CustomEvent('edustack:clean')); };
  window.addEventListener('beforeunload', (event) => { if (dirty) { event.preventDefault(); event.returnValue = ''; } });
  const n = (sel) => { const value = root?.querySelector(sel)?.value; return value === '' || value == null ? null : Number(value); };
  const plain = (value) => value !== '' && value != null ? String(value) : (document.body.dataset.lang === 'zh' ? '未填写' : 'Not filled');
  if (kind === 'growth-chart' || kind === 'daily-routine') {
    const syncPrint = () => root.querySelectorAll('[data-print-field]').forEach((span) => {
      span.textContent = plain(root.querySelector(`[data-${span.dataset.printField}]`).value);
    });
    root.querySelector('.fields').addEventListener('input', () => { out.replaceChildren(); syncPrint(); });
    window.addEventListener('beforeprint', syncPrint);
    syncPrint();
  }
  const show = (title, paragraphs) => {
    if (!out) return;
    out.replaceChildren();
    const heading = document.createElement('strong'); heading.textContent = title; out.append(heading);
    paragraphs.forEach((paragraph) => { const p = document.createElement('p'); p.textContent = paragraph; out.append(p); });
  };
  const validInputs = (selectors) => {
    for (const selector of selectors) {
      const input = root.querySelector(selector);
      if (!input.disabled && !input.checkValidity()) {
        show(c.invalid, [c.invalidText]);
        input.focus(); input.reportValidity(); return false;
      }
    }
    return true;
  };
  if (kind === 'growth-chart') root.querySelector('[data-calculate]').addEventListener('click', () => {
    if (!validInputs(['[data-age]', '[data-height]', '[data-weight]'])) return;
    const height = n('[data-height]');
    const weight = n('[data-weight]');
    const bmi = weight / ((height / 100) ** 2);
    show(c.result, [`${c.age}: ${plain(n('[data-age]'))} · ${c.sex}: ${plain(root.querySelector('[data-sex]').value)}`, `BMI: ${Number.isFinite(bmi) && bmi > 0 ? bmi.toFixed(1) : plain('')}`, c.note]);
  });
  if (kind === 'daily-routine') {
    const ageField = root.querySelector('[data-age]');
    const monthsField = root.querySelector('[data-age-months]');
    const syncAge = () => {
      const infant = ageField.value !== '' && Number(ageField.value) === 0;
      monthsField.disabled = !infant;
      monthsField.required = infant;
      monthsField.closest('label').hidden = !infant;
    };
    ageField.addEventListener('input', syncAge); syncAge();
  }
  if (kind === 'daily-routine') root.querySelector('[data-check]').addEventListener('click', () => {
    if (!validInputs(['[data-age]', '[data-age-months]', '[data-sleep]', '[data-activity]', '[data-screen]'])) return;
    const age = n('[data-age]');
    const months = age * 12 + (age === 0 ? n('[data-age-months]') : 0);
    const sleep = n('[data-sleep]');
    const activity = n('[data-activity]');
    const screen = n('[data-screen]');
    const rules = JSON.parse(dailyRulesJSON);
    const guide = Object.fromEntries(['sleep', 'activity', 'screen'].map((kind) => [kind, rules.find((rule) => rule.kind === kind && rule.minMonths <= months && rule.maxMonths >= months)]));
    const lang = document.body.dataset.lang === 'zh' ? 'zh' : 'en';
    const sleepNote = sleep >= guide.sleep.minimum && sleep <= guide.sleep.maximum ? c.range : c.discussion;
    show(c.result, [`${c.sleep}: ${sleep} · ${guide.sleep.value[lang]} · ${sleepNote}`, `${c.activity}: ${activity} min · ${guide.activity.value[lang]}`, `${c.screen}: ${screen} h · ${guide.screen.value[lang]}`, lang === 'zh' ? '这些提示用于家庭讨论，不是评分或诊断。依据与完整导读见下方。' : 'These prompts are for family discussion, not a score or diagnosis. Sources and full reading notes are below.']);
  });
  if (kind === 'milestones') {
    const checks = root.querySelector('[data-checks]');
    const band = root.querySelector('[data-band]');
    const question = root.querySelector('[data-question]');
    const printQuestion = root.querySelector('[data-print="question"]');
    const emptyState = () => ({ version: 1, band: 'baby', checks: Object.fromEntries(Object.keys(sets).map((key) => [key, []])), question: '' });
    const valid = (value) => value && value.version === 1 && typeof value.band === 'string' && sets[value.band] && value.checks && typeof value.checks === 'object' && typeof value.question === 'string' && value.question.length <= 500;
    let state = emptyState();
    try { const saved = JSON.parse(localStorage.getItem(storageKey) || 'null'); if (valid(saved)) state = saved; } catch { /* Keep the editable blank state. */ }
    const render = () => {
      state.checks[band.value] ||= [];
      const current = state.checks[band.value] || [];
      root.querySelector('[data-print-band]').textContent = band.selectedOptions[0].textContent;
      checks.replaceChildren(...sets[band.value].map((item, index) => {
        const label = document.createElement('label'); label.className = 'check-row';
        const input = document.createElement('input'); input.type = 'checkbox'; input.checked = current[index] === true; input.addEventListener('change', () => { state.checks[band.value][index] = input.checked; markDirty(); });
        const span = document.createElement('span'); span.textContent = item; label.append(input, span); return label;
      }));
      question.value = state.question;
      printQuestion.textContent = state.question || (document.body.dataset.lang === 'zh' ? '未填写' : 'Not filled');
    };
    band.value = state.band; render();
    band.addEventListener('change', () => { state.band = band.value; state.checks[band.value] ||= []; markDirty(); render(); });
    question.addEventListener('input', () => { state.question = question.value; printQuestion.textContent = question.value || (document.body.dataset.lang === 'zh' ? '未填写' : 'Not filled'); markDirty(); });
    root.querySelector('[data-save]').addEventListener('click', () => { if (externalChange && !window.confirm(c.overwriteConfirm)) return; try { localStorage.setItem(storageKey, JSON.stringify(state)); markClean(); out.textContent = c.saved; } catch { out.textContent = c.saveError; } });
    window.addEventListener('storage', (event) => { if (event.key !== storageKey && event.key !== null) return; externalChange = true; out.textContent = c.externalChange; });
  }
  if (kind === 'screen-agreement') {
    const fields = ['name', 'place', 'time', 'before', 'after', 'adult'];
    const read = () => Object.fromEntries(fields.map((field) => [field, root.querySelector(`[data-${field}]`).value]));
    const syncPrint = () => fields.forEach((field) => { root.querySelector(`[data-print="${field}"]`).textContent = root.querySelector(`[data-${field}]`).value || (document.body.dataset.lang === 'zh' ? '未填写' : 'Not filled'); });
    const write = (value) => { fields.forEach((field) => { root.querySelector(`[data-${field}]`).value = value?.[field] || ''; }); syncPrint(); };
    try { write(JSON.parse(localStorage.getItem(storageKey) || 'null')); } catch { /* Keep the empty form. */ }
    fields.forEach((field) => root.querySelector(`[data-${field}]`).addEventListener('input', () => { syncPrint(); markDirty(); }));
    root.querySelector('[data-save]').addEventListener('click', () => { if (externalChange && !window.confirm(c.overwriteConfirm)) return; try { localStorage.setItem(storageKey, JSON.stringify(read())); markClean(); out.textContent = c.saved; } catch { out.textContent = c.saveError; } });
    root.querySelector('[data-clear]').addEventListener('click', () => { if (!window.confirm(c.clearConfirm)) return; try { localStorage.removeItem(storageKey); write(null); markClean(); out.textContent = ''; } catch { out.textContent = c.saveError; } });
    root.querySelector('[data-print]').addEventListener('click', () => window.print());
    window.addEventListener('storage', (event) => { if (event.key !== storageKey && event.key !== null) return; externalChange = true; out.textContent = c.externalChange; });
  }
  root.querySelector('[data-tool-controls]').disabled = false;
  root.querySelector('[data-tool-unavailable]').hidden = true;
</script>
<style>
  .practical-tool { padding-block:2rem 4rem; display:flex; flex-direction:column; gap:2rem; } .intro { max-width:54rem; } .privacy-note { border-inline-start:3px solid var(--accent); padding-inline-start:.75rem; }
  .tool-panel { margin:0; min-inline-size:0; max-width:56rem; display:flex; flex-direction:column; gap:1.25rem; padding:clamp(1rem,3vw,2rem); border:1px solid var(--line); background:var(--paper); } .fields { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,12rem),1fr)); gap:1rem; } label { display:flex; flex-direction:column; gap:.4rem; font-weight:600; } input,select,textarea { min-inline-size:0; max-inline-size:100%; font:inherit; color:var(--ink); background:var(--paper); border:1px solid var(--line-strong); padding:.65rem .75rem; border-radius:0; font-weight:400; } textarea { min-height:5rem; resize:vertical; } .print-value { display:none; } .result { min-height:3rem; border-top:1px solid var(--line); padding-top:1rem; } .result p,.result ul { margin:.5rem 0; } .checks { display:flex; flex-direction:column; gap:.7rem; } .check-row { flex-direction:row; align-items:flex-start; font-weight:400; } .tool-actions { display:flex; flex-wrap:wrap; gap:.75rem; align-items:center; } .agreement { max-width:45rem; } .basis { max-width:56rem; }
  @media print { .practical-tool { padding:0; } .practical-tool > nav,.practical-tool .privacy-note,.practical-tool .chips,.practical-tool .btn,.practical-tool .tool-actions,.practical-tool .basis { display:none; } .tool-panel { border:0; padding:0; } input,textarea,select { display:none; } .print-value { display:block; min-height:1.4em; white-space:pre-wrap; overflow-wrap:anywhere; font-weight:400; } }
</style>

---
import Base from '../layouts/Base.astro';
import { stages, type Lang } from '../lib/data';
import { href } from '../i18n/ui';
import { editorialCopy } from '../i18n/editorial';
interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
---
<Base lang={lang} title={zh ? '按年龄' : 'By age'} active="stages">
<main id="main" tabindex="-1" class="wrap section">
  <h1 class="h-serif" style="font-size:var(--type-feature)">{zh ? '按年龄浏览' : 'Browse by age'}</h1>
  <p class="prose">{zh ? '选一个阶段，从少量精选开始：理解日常相处、读一点经典、了解研究，再找一个用得上的工具。每个阶段也保留详细的成长、活动与健康导读。' : 'Choose a stage and start with a few thoughtful selections: everyday family life, classic reading, research and useful tools. Each stage also has an in-depth guide to growing up, activities and health.'}</p>
  <a href={href(lang)}>{zh ? '返回普通首页' : 'Back to the general homepage'}</a>
  <p class="prose">{editorialCopy[lang].ageNote}</p>
  <div class="grid">
    {stages.map((st) => <a class="card" href={href(lang, `ages/${st.id}`)} style="gap:6px"><span class="muted">{st.range[lang]}</span><span class="card-title" style="font-size:var(--type-section);font-weight:600">{st.name[lang]}</span><span style="color:var(--ink-2)">{st.focus[lang]}</span></a>)}
  </div>
</main>
</Base>

---
import Base from '../layouts/Base.astro';
import ResourceCard from '../components/ResourceCard.astro';
import ResearchBehind from '../components/ResearchBehind.astro';
import { recommendations, researchFor, supportedBy, worldcat, ageLabel, yearLabel, type Lang, type Resource } from '../lib/data';
import { t, href, fmtDate } from '../i18n/ui';
interface Props { lang: Lang; r: Resource }
const { lang, r } = Astro.props;
const s = t(lang);
const zh = lang === 'zh';
const isResearch = r.type === 'research';
const behind = isResearch ? [] : researchFor([r.id]);
const sup = supportedBy(r.id);
const related = isResearch ? [] : recommendations.filter((x) => x.id !== r.id && x.topics.some((tp) => r.topics.includes(tp))).slice(0, 3);
const H = zh
  ? { know: '家长须知', why: '与成长阶段的关系', key: '导读要点', keyNote: '本站摘要与转述，请结合原文阅读', act: '可以怎么用', src: '出处和核验记录', open: '查看原始出处', related: '相关资源' }
  : { know: 'What parents should know', why: 'How it relates to this stage', key: 'Reading notes', keyNote: 'Our summary and paraphrase. Read alongside the source.', act: 'How to use this resource', src: 'Sources and check record', open: 'Visit the original source', related: 'Related' };
const host = new URL(r.url).hostname.replace(/^www\./, '');
const sections = [
  { h: isResearch ? (zh ? '研究发现了什么' : 'What the study found') : H.know, body: r.summary[lang] },
  r.purpose && { h: zh ? '它帮助解决什么问题' : 'What question it helps with', body: r.purpose[lang] },
  r.audience && { h: zh ? '适合谁' : 'Who it is for', body: r.audience[lang] },
  r.whyAge && { h: H.why, body: r.whyAge[lang] },
].filter(Boolean) as { h: string; body: string }[];
let n = 0;
---
<Base lang={lang} title={r.title[lang]} description={r.summary[lang]} active={r.type === 'research' ? 'topics' : 'library'}>
<main id="main" tabindex="-1" class="wrap" style="padding-top:28px;display:flex;flex-direction:column;gap:22px">
  <nav aria-label={zh ? '位置' : 'Breadcrumb'} class="row muted" style="gap:6px;font-size:var(--type-ui)">{isResearch ? <span>{s.behind}</span> : <><a href={href(lang, 'library')}>{s.nav.library}</a><span aria-hidden="true">/</span><span>{s.typePlural[r.type]}</span></>}</nav>
  <div style="display:flex;gap:28px;flex-wrap:wrap;align-items:flex-start">
    <article style="flex:999 1 600px;min-width:0;display:flex;flex-direction:column;gap:18px">
      <header class="card" style="padding:28px;gap:14px">
        <div class="chips"><span class={`chip t-${r.type}`}>{s.type[r.type]}</span>{r.design && <span class="chip">{s.design[r.design]}</span>}<span class="chip lv">{s.evidenceLabel}: {s.evidence[r.evidence]}</span><span class="chip">{zh ? '阅读参考：' : 'Reading relevance: '}{ageLabel(r.minMonths, r.maxMonths, lang)}</span>{r.sex !== 'all' && <span class="chip">{r.sex === 'female' ? (zh ? '女孩' : 'Girls') : (zh ? '男孩' : 'Boys')}</span>}</div>
        <h1 class="h-serif" style="font-size:var(--type-feature);line-height:var(--leading-heading)">{r.title[lang]}</h1>
        {(zh || r.originalTitle) && <p lang="en" class="muted" style="margin:0;font-size:var(--type-ui)">{r.originalTitle ?? r.title.en}</p>}
        <div class="row" style="gap:8px 22px;font-size:var(--type-ui);color:var(--ink-2);border-top:1px solid var(--line-2);padding-top:12px">
          <span><span class="muted">{zh ? '作者或机构' : 'Author or publisher'}</span> {r.by}</span>
          {yearLabel(r, lang) && <span><span class="muted">{zh ? '发表' : 'Published'}</span> {yearLabel(r, lang)}</span>}
          <span><span class="muted">{s.reviewedBy}</span> {s.editors}</span>
          <span><span class="muted">{s.checked}</span> {fmtDate(r.checked, lang)}</span>
        </div>
        <div class="row" style="padding-top:4px;gap:10px"><a class="btn btn-primary" href={r.url} rel="noopener">{H.open} · {host} ↗</a>{r.isbn && <a class="btn btn-ghost" href={worldcat(r.isbn)} rel="noopener">{zh ? '附近图书馆（WorldCat）' : 'Find in a library (WorldCat)'} ↗</a>}</div>
        {r.design && <p style="margin:0;font-size:var(--type-ui);color:var(--ink-2)"><b>{s.design[r.design]}{zh ? '：' : ': '}</b>{s.designNote[r.design]}</p>}
        <p class="muted" style="margin:0;font-size:var(--type-ui)">{s.evidenceHelp}</p>
        {r.evidenceNote && <p style="margin:0;font-size:var(--type-ui);color:var(--ink-2)"><b>{zh ? '证据说明：' : 'Evidence: '}</b>{r.evidenceNote[lang]}</p>}
      </header>
      {sections.map((sec) => <section class="card" style="padding:24px"><h2 style="margin:0;font-size:var(--type-section)"><span class="muted" style="font-size:var(--type-note);margin-right:10px">{++n}</span>{sec.h}</h2><p class="prose">{sec.body}</p></section>)}
      {r.keyPoints && <section class="card" style="padding:24px"><div class="split"><h2 style="margin:0;font-size:var(--type-section)"><span class="muted" style="font-size:var(--type-note);margin-right:10px">{++n}</span>{H.key}</h2><span class="muted" style="font-size:var(--type-note)">{H.keyNote}</span></div><ul class="prose" style="padding-left:20px">{r.keyPoints[lang].map((k) => <li style="margin-bottom:6px">{k}</li>)}</ul></section>}
      {r.actions && <section class="card" style="padding:24px"><h2 style="margin:0;font-size:var(--type-section)"><span class="muted" style="font-size:var(--type-note);margin-right:10px">{++n}</span>{H.act}</h2><ul class="prose" style="padding-left:20px">{r.actions[lang].map((k) => <li style="margin-bottom:6px">{k}</li>)}</ul></section>}
      {r.limits && <section class="card soft" style="padding:24px"><h2 style="margin:0;font-size:var(--type-section)"><span class="muted" style="font-size:var(--type-note);margin-right:10px">{++n}</span>{zh ? '使用限制与需要留意的地方' : 'Limits and things to keep in mind'}</h2><p class="prose">{r.limits[lang]}</p></section>}
      <section class="card" style="padding:24px"><h2 style="margin:0;font-size:var(--type-section)"><span class="muted" style="font-size:var(--type-note);margin-right:10px">{++n}</span>{H.src}</h2>
        <div class="stack" style="gap:6px;font-size:var(--type-ui);color:var(--ink-2)">
          <a href={r.url} style="word-break:break-all" rel="noopener">{r.url}</a>
          <span>{r.by}. {r.originalTitle ?? r.title.en}. {r.year ?? ''}{r.publisher && `. ${r.publisher}`}{r.doi && `. doi:${r.doi}`}{r.isbn && `. ISBN ${r.isbn}`}</span>
          {(r.sourceLinks ?? []).map((source) => <a href={source.url} rel="noopener">{source.label[lang]} ↗</a>)}
          <span>{s.checked} · {fmtDate(r.checked, lang)}</span>
          {r.checkedNote && <p style="margin:0;line-height:var(--leading-body)">{r.checkedNote[lang]}</p>}
          {r.access && <p style="margin:0;line-height:var(--leading-body)"><b>{zh ? '获取与使用：' : 'Access and use: '}</b>{r.access[lang]}</p>}
        </div>
      </section>
      <ResearchBehind items={behind} lang={lang} heading="h3" />
      {isResearch && (sup.resources.length + sup.topics.length + sup.stages.length + sup.educators.length) > 0 && (
        <section class="card" style="padding:24px"><h2 style="margin:0;font-size:var(--type-section)">{zh ? '这项研究出现在哪些建议下面' : 'Where this study is used'}</h2>
          <ul class="prose" style="padding-left:20px">
            {sup.topics.map((x) => <li><a href={href(lang, `topics/${x.id}`)}>{(zh ? '主题：' : 'Topic: ') + x.name[lang]}</a></li>)}
            {sup.stages.map((x) => <li><a href={href(lang, `ages/${x.id}`)}>{(zh ? '年龄阶段：' : 'Age stage: ') + x.name[lang] + ' ' + x.range[lang]}</a></li>)}
            {sup.educators.map((x) => <li><a href={href(lang, `educators/${x.id}`)}>{(zh ? '教育家：' : 'Educator: ') + x.name[lang]}</a></li>)}
            {sup.resources.map((x) => <li><a href={href(lang, `resources/${x.id}`)}>{x.title[lang]}</a></li>)}
          </ul>
        </section>
      )}
      {related.length > 0 && <section class="stack"><h2 style="margin:0;font-size:var(--type-section)">{H.related}</h2><div class="grid">{related.map((x) => <ResourceCard r={x} lang={lang} compact />)}</div></section>}
    </article>
    <aside style="flex:1 1 280px;display:flex;flex-direction:column;gap:14px">
      <dl class="card" style="padding:22px;gap:0;margin:0;font-size:var(--type-ui)">
        {[
          [zh ? '推荐阅读年龄' : 'Recommended reading age', ageLabel(r.minMonths, r.maxMonths, lang)],
          [zh ? '类型' : 'Type', s.type[r.type]],
          [s.evidenceLabel, s.evidence[r.evidence]],
          [zh ? '原文语言' : 'Original language', r.language],
          [zh ? '费用' : 'Cost', r.free ? (zh ? '免费阅读' : 'Free to read') : (zh ? '可能需要购买或订阅' : 'May need purchase or subscription')],
          [zh ? '性别' : 'Sex', r.sex === 'all' ? (zh ? '通用' : 'Applies to all') : r.sex === 'female' ? (zh ? '女孩' : 'Girls') : (zh ? '男孩' : 'Boys')],
        ].map(([k, v]) => <div style="display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--line-2)"><dt class="muted">{k}</dt><dd style="margin:0;text-align:right">{v}</dd></div>)}
      </dl>
      <p class="muted" style="margin:0;font-size:var(--type-ui)">{zh ? '这里指孩子的年龄，供家长选择相关阅读，不是研究对象的年龄或能力标准。原资料涉及的人群与使用限制请看正文。' : 'Ages refer to your child and help you choose relevant reading. They are not the study population or an ability standard. See the text for the source population and limits.'}</p>
      <div class="card soft" style="padding:18px;gap:8px">
        <div style="font-weight:600">{zh ? '资源维护' : 'Resource updates'}</div>
        <p style="margin:0;font-size:var(--type-note)" class="muted">{zh ? '资源链接与内容由编辑核实和更新。' : 'Resource links and information are checked and updated by our editors.'}</p>
      </div>
    </aside>
  </div>
</main>
</Base>

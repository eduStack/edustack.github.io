---
import type { Lang } from '../i18n/languages';

interface Props { lang: Lang }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fonts = [
  'reading-sans', 'editorial-serif',
  ...(lang === 'zh' ? [
    'reading-sans-extended-1', 'reading-sans-extended-2',
    'editorial-serif-extended-1', 'editorial-serif-extended-2',
  ] : []),
];
---
{fonts.map((font) => <link rel="preload" href={`${base}/editorial/${font}.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />)}

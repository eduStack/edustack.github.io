---
import { editorialCopy } from '../i18n/editorial';
import { href, t } from '../i18n/ui';
import type { Lang } from '../i18n/languages';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ProfileContext from './ProfileContext.astro';
import HeaderProfile from './HeaderProfile.astro';

interface Props { lang: Lang; active?: string; home?: boolean; mainId?: string; profileStage?: string; showProfileContext?: boolean }
const { lang, active, home = false, mainId = 'main', profileStage, showProfileContext = true } = Astro.props;
const copy = editorialCopy[lang];
const s = t(lang);
const homeUrl = href(lang);
const activeItem = home ? 'home' : active;
const nav = [
  ['home', ''], ['stages', 'ages'], ['activities', 'activities'], ['tools', 'tools'], ['educators', 'educators'],
  ['topics', 'topics'], ['library', 'library'], ['me', 'me'],
] as const;
---
<a class="skip-link" href={`#${mainId}`}>{copy.skip}</a>
<div class="utility-bar">
  <div class="wrap utility-inner"><span>{copy.tagline} <span class="utility-dot">·</span> {copy.ageSpan}</span><LanguageSwitcher lang={lang} /></div>
</div>
<header class="site-header wrap">
  <div class="masthead">
    <p class="masthead-note">{copy.mastheadFirst}<br>{copy.mastheadSecond}</p>
    <a class="brand" href={homeUrl} aria-label={copy.homeLabel}><span class="brand-name">edu<span>Stack</span><svg viewBox="0 0 34 34" aria-hidden="true"><path d="M7 26C7 15 11 6 26 5c-1 13-7 21-19 21Z"/><path d="m7 28 13-15"/></svg></span><span class="brand-subtitle">THE ART & SCIENCE OF GROWING TOGETHER</span></a>
    <HeaderProfile lang={lang} />
  </div>
  <nav class="main-nav" aria-label={copy.mainNav}>
    <div class="main-nav-links">
      {nav.map(([key, path]) => <a class:list={{ active: activeItem === key }} href={href(lang, path)} aria-current={activeItem === key ? 'page' : undefined}>{s.nav[key]}</a>)}
    </div>
    {home &&
      <a class="search-link" href="#resource-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.7"/><path d="m16 16 5 5"/></svg><span>{copy.search}</span></a>
    }
  </nav>
</header>
<ProfileContext lang={lang} home={home} viewStage={profileStage} showContext={showProfileContext && home} />

---
// Small source link shown after a sentence we wrote. src is a sources.yaml key or a resource id.
import { cite, type Lang } from '../lib/data';
import { href } from '../i18n/ui';
interface Props { src: string; lang: Lang }
const { src, lang } = Astro.props;
const c = cite(src, lang);
---
<a class="cite" href={c.internal ? href(lang, `resources/${c.url}`) : c.url} rel={c.internal ? undefined : 'noopener'}>{c.text}{!c.internal && ' ↗'}</a>

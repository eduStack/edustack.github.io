---
import '../styles/global.css';
import { t, href, switchLang } from '../i18n/ui';
import type { Lang } from '../lib/data';
import { defaultLanguage, languages } from '../i18n/languages';
import SiteHeader from '../components/SiteHeader.astro';
import FontPreloads from '../components/FontPreloads.astro';
import { editorialCopy } from '../i18n/editorial';

interface Props { lang: Lang; title: string; description?: string; active?: string }
const { lang, title, description, active } = Astro.props;
const s = t(lang);
const desc = description ?? editorialCopy[lang].description;
---
<!doctype html>
<html lang={languages[lang].tag}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#faf7f0" />
  <FontPreloads lang={lang} />
  <title>{title} · {s.siteName}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={new URL(switchLang(Astro.url.pathname, lang), Astro.site || Astro.url.origin)} />
  {(Object.keys(languages) as Lang[]).map((code) => <link rel="alternate" hreflang={languages[code].tag} href={new URL(switchLang(Astro.url.pathname, code), Astro.site || Astro.url.origin)} />)}
  <link rel="alternate" hreflang="x-default" href={new URL(switchLang(Astro.url.pathname, defaultLanguage), Astro.site || Astro.url.origin)} />
  <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/edustack-icon.svg`} type="image/svg+xml" />
</head>
<body data-lang={lang}>
  <SiteHeader lang={lang} active={active} mainId={active === 'me' ? 'me' : 'main'} />
  <slot />
  <footer class="site-footer interior-footer">
    <div class="wrap footer-inner">
      <div class="footer-description"><a class="footer-brand" href={href(lang)}>{s.siteName}<span>{s.tagline}</span></a><strong>{s.footerTitle}</strong><p>{s.footerBody}</p></div>
      <div class="footer-links"><a href={href(lang, '#about')}>{s.whatWeInclude}</a><a href={`${import.meta.env.BASE_URL}reference/${lang === 'zh' ? 'zh/' : ''}`}>{s.designReference}</a></div>
    </div>
  </footer>
</body>
</html>
